q0djlyb7","characterId":"group_1786306664134","_id":3133},{"id":1786314414409,"sender":"them","senderCharId":"98c215ab-3590-4eda-9695-f32fc263bb1b","senderName":"Nagi","text":"スマホの画面を見て一瞬舌打ちするが、すぐにいつもの笑顔を取り繕う","timestamp":"2026-08-09T21:07:43.916Z","type":"state","translation":"看着手机屏幕瞬间啧了一声，但马上又换上了平时的无辜笑脸","roundId":"group_round_1786309626482_zr958su","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3134},{"id":1786314414410,"sender":"them","senderCharId":"98c215ab-3590-4eda-9695-f32fc263bb1b","senderName":"Nagi","text":"おはようございます！全然迷惑なんてかけてないですよ。今お母さんと一緒にキッチンに向かってるんです","timestamp":"2026-08-09T21:07:46.777Z","replyTo":{"id":1786314414408,"text":"おはよう。朝から随分と元気だな、Nagi。千音の迷惑になっていないといいが","sender":"them","senderName":"Asahi"},"translation":"早上好！完全没有添麻烦哦。我现在正和妈妈一起去厨房呢","roundId":"group_round_1786309626482_zr958su","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3135},{"id":1786314414411,"sender":"them","senderCharId":"98c215ab-3590-4eda-9695-f32fc263bb1b","senderName":"Nagi","text":"叔父さんの分も何か作ろうか？","timestamp":"2026-08-09T21:07:48.164Z","translation":"要不要连叔叔的那份也一起做了？","roundId":"group_round_1786309626482_zr958su","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3136},{"id":1786314414412,"sender":"them","senderCharId":"f5fa8337-59ec-4c06-b702-d541dea98630","senderName":"Asahi","text":"いや、私の分は結構だ。朝から千音の手を煩わせたくないからね","timestamp":"2026-08-09T21:07:50.860Z","translation":"不用了，我的那份就不必了。我可不想大清早就让千音太受累","roundId":"group_round_1786309626482_zr958su","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3137},{"id":1786314414415,"sender":"them","text":"啊，没关系的，反正也是要准备的，一起准备了就是","replyTo":null,"timestamp":"2026-08-09T21:10:37.629Z","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","senderCharId":"uid_1786304682408_dsdrl3mje","senderName":"用戶","_id":3138},{"id":1786314414416,"sender":"them","text":"何况你早上不是还要去上班？","replyTo":null,"timestamp":"2026-08-09T21:10:43.808Z","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","senderCharId":"uid_1786304682408_dsdrl3mje","senderName":"用戶","_id":3139},{"id":1786314414417,"sender":"them","text":"哦对了，小凪说他头痛……我已经答应帮他请假了来着","replyTo":null,"timestamp":"2026-08-09T21:11:15.391Z","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","senderCharId":"uid_1786304682408_dsdrl3mje","senderName":"用戶","_id":3140},{"id":1786314414418,"sender":"them","senderCharId":"f5fa8337-59ec-4c06-b702-d541dea98630","senderName":"Asahi","text":"端着刚冲好的咖啡，看着手机屏幕轻笑了一声","timestamp":"2026-08-09T21:11:42.058Z","type":"state","roundId":"group_round_1786309876070_6swid36","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3141},{"id":1786314414419,"sender":"them","senderCharId":"f5fa8337-59ec-4c06-b702-d541dea98630","senderName":"Asahi","text":"頭痛か。それは可哀想に。私が知り合いの医者を呼ぼうか？","timestamp":"2026-08-09T21:11:44.738Z","translation":"头痛？那还真是可怜。需要我叫认识的医生过来看看吗？","roundId":"group_round_1786309876070_6swid36","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3142},{"id":1786314414420,"sender":"them","senderCharId":"f5fa8337-59ec-4c06-b702-d541dea98630","senderName":"Asahi","text":"千音も看病で無理をしないように。下に君の分のコーヒーを置いてあるから、少し休んで","timestamp":"2026-08-09T21:11:47.364Z","translation":"千音照顾他的时候也别太勉强自己。楼下放着你的咖啡，稍微休息一下吧","roundId":"group_round_1786309876070_6swid36","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3143},{"id":1786314414421,"sender":"them","senderCharId":"98c215ab-3590-4eda-9695-f32fc263bb1b","senderName":"Nagi","text":"靠在床头撇了撇嘴，故意咳嗽了两声才继续打字","timestamp":"2026-08-09T21:11:50.261Z","type":"state","roundId":"group_round_1786309876070_6swid36","userId":"uid_1786136368890_6q0djlyb7","characterId":"group_1786306664134","_id":3144},{"id":1786314414422,"sender":"them","senderCharId":"98c215ab-3590-4eda-9695-f32fc263bb1b","senderName":"Nagi","text":"お医者さんなんて大げさだよ！お母さんのお粥を食べたらすぐ治